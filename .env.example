# ─── RayNews 本地配置 ───────────────────────────────
# 复制此文件为 .env 后修改

# Telegram 频道来源（必填其一，需为公开频道）
# RayNews 从此频道抓取消息。消息来源可以是：
# - RSS-to-Telegram-Bot 自动推送
# - 手动发送
# - 或其他方式
#
# 推荐：直接指定完整频道链接（域名可换成镜像域名，无需改代码）
# TELEGRAM_CHANNEL_URL=https://telegram.me/s/your_channel_name
#
# 旧配置方式（仅指定频道名，域名固定为 t.me）：
# TELEGRAM_CHANNEL=your_channel_name

# 登录态配置
# 如果不设置 RAYNEWS_SECRET，服务会自动生成并保存到 /app/data/raynews_secret。
# 也可以手动固定，可用 `openssl rand -hex 32` 生成。
# RAYNEWS_SECRET=
# RAYNEWS_TOKEN_EXPIRY_SECONDS=2592000

# 代理配置（如果需要翻墙抓取）
# HTTP_PROXY=http://192.168.1.100:7890
# HTTPS_PROXY=http://192.168.1.100:7890
# NO_PROXY=localhost,127.0.0.1,192.168.0.0/16

# 登录反向代理信任范围：仅填写会直接连接到 RayNews 的代理地址段。
# 留空时仅信任本机代理（127.0.0.1/32,::1/128）提供的 X-Real-IP。
# TRUSTED_PROXY_PREFIXES=127.0.0.1/32,::1/128

# Custom raw HTML injected into <head>, for analytics scripts or meta tags.
# CUSTOM_HEAD_HTML=<script defer src="https://your-analytics.example.com/script.js" data-website-id="xxxxx"></script>

# RayNews 对外访问地址，用于邮件底部链接
# RAYNEWS_PUBLIC_URL=https://news.example.com

# 邮件配置
# RESEND_API_KEY=
# RAYNEWS_ADMIN_EMAIL=admin@example.com
# RAYNEWS_FROM_EMAIL=news@example.com

# 后台自动文章摘要批处理配置
# AUTO_SUMMARY_BATCH_LIMIT=20
# AUTO_SUMMARY_INTERVAL_SECONDS=30

# 后台自动翻译批处理配置
# AUTO_TRANSLATION_BATCH_LIMIT=5
# AUTO_TRANSLATION_INTERVAL_SECONDS=30

# 后台自动订阅源分类配置（使用已启用 AI 的用户自己的 API 配置）
# AUTO_SOURCE_CLASSIFY_BATCH_LIMIT=20
# AUTO_SOURCE_CLASSIFY_INTERVAL_SECONDS=120

# 主机 IP（用于 extra_hosts，按需配置）
# HOST_IP=192.168.1.100
